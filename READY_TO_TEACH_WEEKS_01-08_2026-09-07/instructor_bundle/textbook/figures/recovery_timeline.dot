digraph RecoveryTimeline {
  graph [bgcolor="transparent", rankdir=LR, pad=0.25, nodesep=0.3, ranksep=0.4,
         fontname="Avenir Next"];
  node [shape=circle, style=filled, width=0.55, fixedsize=true, fontname="Avenir Next",
        fontsize=10, color="#16324F", fillcolor="#FFFFFF", fontcolor="#16324F",
        penwidth=1.6];
  edge [color="#16324F", penwidth=2, arrowsize=0.75, fontname="Avenir Next",
        fontsize=10, fontcolor="#16324F"];

  recovered [label="t_r", fillcolor="#EAF4F3", color="#1F6F78"];
  failure [label="t_f", fillcolor="#FBEDE8", color="#C8653B"];
  acceptable [label="t_a", fillcolor="#E9F1F8", color="#2E5F87"];

  recovered -> failure [label="realized data-loss window\ncompare with RPO target", color="#C8653B"];
  failure -> acceptable [label="realized recovery duration\ncompare with RTO target", color="#2E5F87"];
}
