digraph ReplicaSet {
  graph [bgcolor="transparent", rankdir=LR, pad=0.25, nodesep=0.35, ranksep=0.55,
         fontname="Avenir Next"];
  node [shape=cylinder, style=filled, fontname="Avenir Next", fontsize=10,
        color="#1F6F78", fillcolor="#F4F8F7", fontcolor="#16324F", penwidth=1.4,
        margin="0.12,0.08"];
  edge [color="#1F6F78", penwidth=1.5, arrowsize=0.75, fontname="Avenir Next",
        fontsize=9, fontcolor="#51606D"];

  client [shape=box, style="rounded,filled", label="Application client", fillcolor="#FFFFFF"];
  primary [label="Primary\naccepts writes", fillcolor="#EAF4F3"];
  secondary1 [label="Secondary A\nreplicates oplog"];
  secondary2 [label="Secondary B\nreplicates oplog"];
  election [shape=diamond, label="Election after\nprimary loss", fillcolor="#FFF4E8", color="#C8653B"];

  client -> primary [label="writes"];
  primary -> secondary1 [label="asynchronous replication"];
  primary -> secondary2 [label="asynchronous replication"];
  primary -> election [style=dashed, color="#C8653B", label="failure detected"];
  secondary1 -> election [style=dashed, color="#C8653B"];
  secondary2 -> election [style=dashed, color="#C8653B"];
}
