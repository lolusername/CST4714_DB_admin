digraph query_plan_flow {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.38, ranksep=0.6,
         fontname="Georgia", fontsize=19, label="One question: the twenty newest open tickets", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#F7F3EA", color="#243A46",
        fontname="Georgia", fontsize=17, margin="0.18,0.14", penwidth=1.4];
  edge [color="#243A46", fontname="Georgia", fontsize=15, penwidth=1.5];
  scan [label="Sequential scan\nTest 100,000 tickets"];
  sort [label="Top-N sort\nCompare 2,000 open tickets"];
  result1 [label="Return 20 tickets", fillcolor="#D9ECE4"];
  index [label="Index ordered by\nstatus, then opened_at"];
  fetch [label="Read newest open entries\nFetch matching table rows"];
  result2 [label="Return the same 20\nStop reading early", fillcolor="#D9ECE4"];
  scan -> sort [label="2,000 kept"];
  sort -> result1 [label="20 newest"];
  index -> fetch [label="open range"];
  fetch -> result2 [label="no extra sort"];
  {rank=same; scan; index;}
  {rank=same; sort; fetch;}
  {rank=same; result1; result2;}
}
