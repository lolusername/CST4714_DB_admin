digraph NoSQLModels {
  graph [bgcolor="transparent", rankdir=LR, pad=0.3, nodesep=0.25, ranksep=0.75,
         fontname="Avenir Next"];
  node [shape=box, style="rounded,filled", fontname="Avenir Next", fontsize=10,
        color="#1F6F78", fillcolor="#F4F8F7", fontcolor="#16324F", penwidth=1.3,
        margin="0.14,0.09"];
  edge [color="#7B8791", penwidth=1.4, arrowsize=0.7, fontname="Avenir Next",
        fontsize=9, fontcolor="#51606D"];

  workload [label="Start with the\nworkload question", shape=hexagon,
            fillcolor="#16324F", fontcolor="#FFFFFF", color="#16324F", fontsize=12];
  kv [label="Key-value\nexact-key lookup"];
  wide [label="Wide-column\nsparse rows by access key"];
  doc [label="Document\nbounded nested aggregate", fillcolor="#EAF4F3"];
  graphdb [label="Graph\nrelationship paths"];
  vector [label="Vector search\nsemantic neighbors"];

  workload -> kv;
  workload -> wide;
  workload -> doc;
  workload -> graphdb;
  workload -> vector;
}
